# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_or_group_id

# Redis (matches docker-compose service name)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Tuning (optional)
DNSE_CONCURRENCY=50
DNSE_TIMEOUT=10.0
DNSE_MAX_RETRIES=3

# Alert thresholds
ATO_THRESHOLD=3.0
WARNING_THRESHOLD=2.0
CRITICAL_THRESHOLD=3.0

# VMA9
VMA9_MIN_DAYS=3
VMA9_LOOKBACK_DAYS=9
VMA9_HISTORY_FETCH_DAYS=25

# EOD summary filter (actual vol/value cuoi phien, cung don vi DNSE)
EOD_MIN_VOLUME=1000000
EOD_MIN_VALUE=10000000

LOG_LEVEL=INFO

